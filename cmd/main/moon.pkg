import {
  "conglinyizhi/screenstream/moonutil" @util,
  "moonbitlang/core/env",
  "conglinyizhi/screenstream" @store,
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/http",
  "moonbitlang/async/socket",
  "moonbitlang/core/argparse",
  "bobzhang/crescent",
}

supported_targets = "+native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "-lpipewire-0.3 -ljpeg -lwebp -lpng" } },
)
