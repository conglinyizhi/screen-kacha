[Unit]
Description=screen-kacha 本机屏幕快照服务（MoonBit）
Documentation=file://@DATA@/error.md
# 挂在桌面会话目标上：等 compositor 起来、Wayland socket 建好再启动。
# 写成 WantedBy=default.target 会在 Wayland 就绪前拉起抓屏工具，
# Qt 找不到 wl_display 直接 abort，还会弹崩溃框、留 coredump。
After=graphical-session.target plasma-kwin_wayland.service
PartOf=graphical-session.target
Wants=plasma-kwin_wayland.service
# 崩溃循环要停下来。没有这个，同一个错误会把 journal 刷满，
# 真正的第一条报错反而看不见了。
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
Type=simple
WorkingDirectory=@DATA@
Environment=XDG_RUNTIME_DIR=%t
Environment=WAYLAND_DISPLAY=@WAYLAND@
Environment=PATH=@BIN@:/usr/local/bin:/usr/bin
ExecStart=@BIN@/screen-kacha --instance @INSTANCE@ --port @PORT@ --bind @BIND@ --source auto --shm @SHM@ --portal-dir %t/screen-kacha
Restart=always
RestartSec=3
# 指数退避：3s → 6s → 12s → 24s → 48s → 60s（封顶）。
# 固定 3 秒在「旧实例正在退出、端口还没放」这种场景下够用，但在 systemd
# 这层反复重启满 5 次就放弃了（约 18 秒）；拉开间隔之后同样几次重试能覆盖
# 到一分半，容得下慢退出的进程。真崩起来也不会刷屏。
RestartSteps=5
RestartMaxDelaySec=60
TimeoutStopSec=10
NoNewPrivileges=yes

# 下面这些收缩每一条都在真机上验过：spectacle 仍然能截图。
# （`--source spectacle` 是 PipeWire 挂掉之后的退路，不能为了 hardening 弄断它。）
# 没加 ProtectHome：spectacle 要往 ~/.config、~/.local/share、~/.cache 写东西，
# 加上就得把这几个目录再开回来，等于没关。
ProtectSystem=strict
ReadWritePaths=%t
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
UMask=0077
CapabilityBoundingSet=

[Install]
WantedBy=graphical-session.target
