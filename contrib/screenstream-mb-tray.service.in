[Unit]
Description=screenstream 托盘（MoonBit）
After=graphical-session.target plasma-kwin_wayland.service screenstream-mb.service
PartOf=graphical-session.target
# 崩溃循环要停下来。没有这个，同一个错误会把 journal 刷满，
# 真正的第一条报错反而看不见了。
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=%t
Environment=WAYLAND_DISPLAY=@WAYLAND@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=PATH=@BIN@:/usr/local/bin:/usr/bin
ExecStart=@BIN@/screenstream-mb-tray --port @PORT@
Restart=always
RestartSec=3

# 托盘会跑 shell（cat、systemctl），文件系统级限制一律不加，
# 只堵住提权这条路。
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
