import {
  "conglinyizhi/screenstream/moonpipewire" @pipewire,
  "conglinyizhi/screenstream/moonimage" @image,
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/async/http",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "bobzhang/crescent",
}

supported_targets = "+native"

options(
  link: { "native": { "cc-link-flags": "-lpipewire-0.3 -ljpeg -lwebp" } },
)
