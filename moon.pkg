import {
  "conglinyizhi/screen-kacha/moonutil" @util,
  "conglinyizhi/screen-kacha/moonpipewire" @pipewire,
  "conglinyizhi/screen-kacha/moonimage" @image,
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/async/http",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "bobzhang/crescent",
}

supported_targets = "+native"

options(
  "native-stub": [ "pid_stub.c" ],
  link: { "native": { "cc-link-flags": "-lpipewire-0.3 -ljpeg -lwebp -lpng" } },
)
