import {
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "+native"

options(
  "native-stub": [ "pw_shim.c" ],
  link: {
    "native": {
      "cc-flags": "-I/usr/include/pipewire-0.3 -I/usr/include/spa-0.2",
      "stub-cc-flags": "-I/usr/include/pipewire-0.3 -I/usr/include/spa-0.2",
      "cc-link-flags": "-lpipewire-0.3",
    },
  },
)
